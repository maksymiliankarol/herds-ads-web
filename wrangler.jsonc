{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "herds-ads-web",
	"compatibility_date": "2026-11-20",
	"routes": [
		{
			"pattern": "herds-ads.metalogrom.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	}
}